<Window x:Class="WpfApp1.AddEditOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление / редактирование заказа"
        Height="520" Width="550"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="White"
        FontFamily="Times New Roman">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <TextBlock Name="txtTitle"
                   Text="Добавление заказа"
                   FontSize="23"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" Margin="15">

            <TextBlock Text="Артикул товара:"
                       FontSize="15" Margin="0,5"/>

            <ComboBox Name="cmbProduct"
                      Height="30"
                      DisplayMemberPath="articule"/>

            <TextBlock Text="Статус заказа:"
                       FontSize="15" Margin="0,10,0,5"/>

            <ComboBox Name="cmbStatus"
                      Height="30"
                      DisplayMemberPath="status1"/>

            <TextBlock Text="Адрес пункта выдачи:"
                       FontSize="15" Margin="0,10,0,5"/>

            <ComboBox Name="cmbPickup"
                      Height="30"/>

            <TextBlock Text="Дата заказа:"
                       FontSize="15" Margin="0,10,0,5"/>

            <DatePicker Name="dpOrderDate"
                        Height="30"/>

            <TextBlock Text="Дата выдачи:"
                       FontSize="15" Margin="0,10,0,5"/>

            <DatePicker Name="dpDeliveryDate"
                        Height="30"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

            <Button Content="Сохранить"
                    Width="120" Height="35"
                    Margin="10"
                    Background="#00FA9A"
                    Click="btnSave_Click"/>

            <Button Content="Отмена"
                    Width="120" Height="35"
                    Margin="10"
                    Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
