<Window x:Class="WpfApp1.edittovar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="edittovar" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Управление товаром" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <Image Name="PhotoTovarIm" Height="80" Width="80" Stretch="Uniform" Margin="0,0,15,0"/>
            <StackPanel VerticalAlignment="Center">
                <Button Content="Выбрать фото" Name="SelectImageBtn" Width="120" Height="25" Click="SelectImageBtn_Click"/>
                <TextBox Name="FileNameTB" Text="{Binding PHOTO}" Width="120" IsReadOnly="True" Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <UniformGrid Grid.Row="2" Columns="2" VerticalAlignment="Top">
            <TextBlock Text="Артикул:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding articule}" Margin="5"/>

            <TextBlock Text="Наименование:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox Name="cmbNameProduct" SelectedValue="{Binding nameidproduct}" SelectedValuePath="id" DisplayMemberPath="name" Margin="5"/>

            <TextBlock Text="Категория:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox Name="cmbCategory" SelectedValue="{Binding category}" SelectedValuePath="id" DisplayMemberPath="name" Margin="5"/>

            <TextBlock Text="Описание:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding description}" Margin="5"/>

            <TextBlock Text="Производитель:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox Name="cmbProizvod" SelectedValue="{Binding proizvod}" SelectedValuePath="id" DisplayMemberPath="name" Margin="5"/>

            <TextBlock Text="Поставщик:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox Name="cmbPostavwik" SelectedValue="{Binding postavwik}" SelectedValuePath="id" DisplayMemberPath="name" Margin="5"/>

            <TextBlock Text="Цена:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding cost}" Margin="5"/>

            <TextBlock Text="Ед. измерения:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding measure}" Margin="5"/>

            <TextBlock Text="На складе:" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding count}" Margin="5"/>

            <TextBlock Text="Скидка (%):" VerticalAlignment="Center" Margin="5"/>
            <TextBox Text="{Binding skidka}" Margin="5"/>
        </UniformGrid>

        <Button Grid.Row="3" Content="Сохранить" Name="SaveBtn" Height="30" Width="150" Click="SaveBtn_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>
