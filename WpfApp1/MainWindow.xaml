<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800" Icon="/Images/Icon.ico">
    <Grid>
        <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" Width="200">
            <TextBlock Text="Логин" Margin="5" FontSize="16" />
            <TextBox Name="txtLogin" HorizontalAlignment="Center" Height="25" Width="200" Margin="0,5,0,15"/>

            <TextBlock Text="Пароль" Margin="5" FontSize="16"/>
            <PasswordBox Margin="5" Name="Password"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Width="152">
                <Button Width="45" Height="39" Content="Войти"  Background="Green" Click="Button_Click"/>
                <Button Width="94" Height="39" Margin="5" Content="Войти как гость"  Background="Gray" Click="Button_Click_1"/>

            </StackPanel>
        </StackPanel>


    </Grid>
</Window>
