<Window x:Class="WpfApp1.tovar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="tovar" Height="450" Width="800" Icon="/Images/Icon.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="79*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#7FFF00" Margin="5,5,5,5" Grid.ColumnSpan="2">
            <Grid>
                <Button Content="Выйти из системы" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" Width="120" Height="25" Click="btnExit_Click"/>
                <Image Grid.Column="0" Height="50" Width="50" Stretch="Uniform" VerticalAlignment="Top" Source="/Images/Icon.png" HorizontalAlignment="Center" Margin="-175,0,0,0"></Image>

                <TextBlock Text="ООО Обувь" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Name="txtFio" Text="ФИО" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" FontSize="14"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="#7FFF00" Margin="5,5,5,5" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                <TextBlock Text="Поиск: " VerticalAlignment="Center"/>
                <TextBox Name="txtSearch" Width="99" Height="20" TextChanged="txtSearch_TextChanged" Margin="0,0,15,0"/>
                <Button Content="По возрастанию" Height="25" Margin="0,0,5,0" Click="btnSortAsc_Click"/>
                <Button Content="По убыванию" Height="25" Margin="0,0,15,0" Click="btnSortDesc_Click"/>
                <TextBlock Text="Поставщик: " VerticalAlignment="Center"/>
                <ComboBox Name="cmbSupplier" DisplayMemberPath="name" Width="91" Height="20" SelectionChanged="cmbSupplier_SelectionChanged" Margin="0,0,15,0"/>
                <Button Content="Сбросить" Height="25" Width="63" Click="btnReset_Click"/>
                <Button Content="Добавить товар" Name="AddBtn" Height="25" Margin="5,0,5,0" Click="AddBtn_Click" Width="91"/>
                <Button Content="Удалить товар" Name="DeleteBtn" Height="25" Margin="0,0,15,0" Click="DeleteBtn_Click"/>
                <Button Content="Заказы"
        Name="btnOrders"
        Height="25"
        Width="90"
        Margin="5,0,5,0"
        Click="btnOrders_Click"/>
            </StackPanel>
        </Border>
        <ListView Grid.Row="2" Name="lview" Margin="5,5,5,5" Grid.ColumnSpan="2" MouseDoubleClick="lview_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding is_quantity}" Value="True">
                            <Setter Property="Background" Value="Cyan"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding is_discount}" Value="True">
                            <Setter Property="Background" Value="#2E8B57"/>
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="2" BorderBrush="Black" Margin="2" Padding="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Height="90" Width="90" Stretch="Uniform" VerticalAlignment="Top"
       Source="{Binding PHOTO, StringFormat='C:\\Users\\evsee\\OneDrive\\Рабочий стол\\ХУЙНЯ\\ХУЕТЕНЬ\\xyina\\dd\\{0}'}"/>


                            <StackPanel Grid.Column="1" Margin="10,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="Артикул: " FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding articule}" FontWeight="Bold" FontSize="14"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Описание товара: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding description}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Поставщик: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding postavwik1.name}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Производитель: " FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding nameproizvod.name}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,4">
                                    <TextBlock Text="Старая цена: "/>
                                    <TextBlock Text="{Binding cost}"/>
                                    <TextBlock Text=" руб. | Новая цена: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding price_discount}" FontWeight="Bold"/>
                                    <TextBlock Text=" руб." FontWeight="Bold"/>
                                </StackPanel>

                                <StackPanel Name="panelCount" Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="Количество на складе: "/>
                                    <TextBlock Text="{Binding count}"/>
                                    <TextBlock Text=" "/>
                                    <TextBlock Text="{Binding measure}"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding skidka, StringFormat={}{0}%}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>

</Window>
