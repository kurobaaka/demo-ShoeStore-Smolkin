<Window x:Class="WpfApp1.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список заказов"
        Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="White"
        FontFamily="Times New Roman">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#7FFF00" Margin="5">
            <Grid>
                <TextBlock Text="Список заказов"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#7FFF00" Margin="5">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="10,0">

                <Button Name="btnAdd"
                        Content="Добавить заказ"
                        Width="130" Height="30"
                        Margin="5"
                        Click="btnAdd_Click"/>

                <Button Name="btnDelete"
                        Content="Удалить заказ"
                        Width="130" Height="30"
                        Margin="5"
                        Click="btnDelete_Click"/>

                <Button Content="Обновить"
                        Width="100" Height="30"
                        Margin="5"
                        Click="btnRefresh_Click"/>

                <Button Content="Назад"
                        Width="100" Height="30"
                        Margin="5"
                        Click="btnBack_Click"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2"
                  Name="dgOrders"
                  Margin="5"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  CanUserAddRows="False"
                  MouseDoubleClick="dgOrders_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер заказа"
                                    Binding="{Binding OrderId}"
                                    Width="100"/>

                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding Article}"
                                    Width="120"/>

                <DataGridTextColumn Header="Статус"
                                    Binding="{Binding Status}"
                                    Width="150"/>

                <DataGridTextColumn Header="Пункт выдачи"
                                    Binding="{Binding PickupAddress}"
                                    Width="*"/>

                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding OrderDate, StringFormat=dd.MM.yyyy}"
                                    Width="130"/>

                <DataGridTextColumn Header="Дата выдачи"
                                    Binding="{Binding DeliveryDate, StringFormat=dd.MM.yyyy}"
                                    Width="130"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
